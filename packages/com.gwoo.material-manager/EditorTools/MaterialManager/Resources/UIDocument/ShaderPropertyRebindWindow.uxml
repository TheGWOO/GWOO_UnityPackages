<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:mm="GWOO.Editor.Tools" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="rebind-popup-root" class="mm-column mm-grow mm-popup-shell">
        <mm:PopupHeaderBlock name="popup-header" />
        <mm:SearchBarBlock name="popup-search-bar" />

        <ui:VisualElement name="quick-actions-row" class="mm-row">
            <ui:Button name="auto-map-button" text="Auto-map compatible" class="mm-flex" />
            <ui:Button name="clear-mappings-button" text="Clear mappings" class="mm-flex" />
            <ui:Button name="remove-invalid-button" text="Remove invalid mappings" class="mm-flex" />
        </ui:VisualElement>

        <ui:Label name="summary-label" class="mm-popup-summary" />

        <ui:ScrollView name="mapping-scroll" class="mm-popup-scroll">
            <ui:VisualElement name="rows-root" class="mm-column mm-grow" />
        </ui:ScrollView>

        <ui:VisualElement name="footer-buttons-row" class="mm-row mm-popup-footer">
            <ui:Button name="reset-button" text="Reset" class="mm-flex" />
            <ui:Button name="apply-button" text="Apply mapping" class="mm-cta mm-flex" />
            <ui:Button name="cancel-button" text="Cancel" class="mm-flex" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
